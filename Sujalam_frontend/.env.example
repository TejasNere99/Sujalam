# =============================================================================
# SUJALAM 2.0 — FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. Only .env.example should be committed.
# In Vercel: set VITE_API_BASE_URL in the Vercel dashboard under Settings > Environment Variables
# =============================================================================

# URL of your deployed Render backend (no trailing slash)
# Local development: http://localhost:3000/api
# Production: https://sujalam-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:3000/api
