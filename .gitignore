# Dependencies
node_modules/

# Build output
dist/
*.js.map
*.d.ts.map
# Stray compiled artifacts from root-level tsc runs
server/index.js
server/index.d.ts
shared/types/*.js
shared/types/*.d.ts

# Environment variables — NEVER commit these
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
coverage/

# Scratch / test scripts (contain hardcoded secrets or are not production code)
testScript.ts
testSave.ts
updateDb.js
*.scratch.*

# Runtime data generated by Blackout Resilience system
# These are local DB snapshots that may contain PII (user emails, farm data)
recovery/

# OS
.DS_Store
Thumbs.db
