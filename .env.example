# =============================================================================
# SUJALAM 2.0 — BACKEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. Only .env.example should be committed.
# =============================================================================

# ---- DATABASE ----------------------------------------------------------------
# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

MONGODB_DB_NAME=sujalam

# ---- AUTHENTICATION ----------------------------------------------------------
# Strong random secret for signing JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED — server will refuse to start without this.
JWT_SECRET=

JWT_EXPIRES_IN=7d

# ---- EXTERNAL APIs -----------------------------------------------------------
# Plant.id API for crop disease identification
# Get key at: https://plant.id/
PLANT_ID_API_KEY=

# OpenWeatherMap API for weather data
# Get key at: https://openweathermap.org/api
WEATHER_API_KEY=

# Government market data API
# Get key at: https://data.gov.in/
MARKET_API_KEY=

# ---- WHATSAPP BUSINESS API --------------------------------------------------
# Required only if WhatsApp chatbot feature is used
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- AI CONFIGURATION -------------------------------------------------------
# Set to 'mock' for demos without internet / free operation
# Set to 'openrouter' to use real AI
AI_PROVIDER=openrouter

# OpenRouter API key — get one at https://openrouter.ai/
OPENROUTER_API_KEY=

OPENROUTER_MODEL=openai/gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ---- SERVER ------------------------------------------------------------------
PORT=3000
NODE_ENV=development
